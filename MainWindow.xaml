<Window x:Class="CleanSweep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanSweep"
        Width="880" Height="760"
        MinWidth="720" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="15" Background="#E4E9FF" VerticalAlignment="Center">
                <TextBlock Text="C" FontSize="27" FontWeight="Bold" Foreground="#5367D8"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="CleanSweep" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="A tidy-up for temporary files and cache folders" FontSize="12.5"
                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Column="2" Background="#E8F5EF" CornerRadius="10" Padding="11,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#31A66B" VerticalAlignment="Center" />
                    <TextBlock Text="LOCAL CLEANUP" FontSize="10" FontWeight="Bold" Foreground="#287B54" Margin="7,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Folder actions -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="16"
                Padding="17" Margin="0,0,0,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cleanup locations" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Choose which folders CleanSweep should empty." FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SelectAllButton" Content="Select all" Style="{StaticResource QuietButton}" Click="SelectAll_Click" Margin="0,0,7,0" />
                    <Button x:Name="ClearSelectionButton" Content="Clear" Style="{StaticResource QuietButton}" Click="ClearSelection_Click" Margin="0,0,7,0" />
                    <Button x:Name="AddFolderButton" Content="＋  Add folder" Style="{StaticResource PrimaryButton}" Click="AddFolder_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Locations list -->
        <Border x:Name="FolderListCard" Grid.Row="2" Background="{StaticResource CardBrush}"
                CornerRadius="16" Padding="15" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="3,0,3,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FOLDERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="LocationsCountText" Grid.Column="1" Text="0 locations" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FolderItems" ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFBFE" BorderBrush="#EDF0F6" BorderThickness="1"
                                        CornerRadius="12" Padding="11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                                  Margin="1,0,11,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                            <TextBlock Text="{Binding Path}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="#7D86A0" />
                                                <TextBlock Text="  •  " FontSize="9" Foreground="#A8AEC0" />
                                                <TextBlock Text="{Binding AvailabilityLabel}" FontSize="9"
                                                           Foreground="#8B92A5" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#F0F2F8" CornerRadius="7" Padding="8,5"
                                                VerticalAlignment="Center" Margin="8,0,8,0">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="8.5" FontWeight="Bold"
                                                       Foreground="#77809A" />
                                        </Border>
                                        <Button Grid.Column="3" Content="Remove" Style="{StaticResource QuietButton}"
                                                Padding="9,6" FontSize="11" IsEnabled="{Binding IsCustom}"
                                                Tag="{Binding}" Click="RemoveFolder_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="Missing folders stay in list, but will be skipped during cleanup."
                           FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="3,8,3,0" />
            </Grid>
        </Border>

        <!-- Progress and run action -->
        <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="16"
                Margin="0,14,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="1,0,1,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Ready. Select folders, then start cleanup."
                               FontSize="11.5" Foreground="#65708B" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProgressText" Grid.Column="1" Text=""
                               FontSize="11" FontWeight="SemiBold" Foreground="#5367D8" />
                </Grid>
                <ProgressBar x:Name="CleanupProgressBar" Grid.Row="1" Height="7" Minimum="0" Maximum="100"
                             Value="0" IsIndeterminate="False" Background="#EEF1F8" Foreground="#5367D8" />
                <Grid Grid.Row="2" Margin="1,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#E0A33A" VerticalAlignment="Center" />
                        <TextBlock Text="  Locked items may be skipped. Running apps are never closed."
                                   FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Button x:Name="CleanButton" Grid.Column="1" Content="Clean selected folders"
                            Style="{StaticResource PrimaryButton}" Click="CleanButton_Click" MinWidth="190" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
